---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/site';
import { personId, personSchema, websiteId, websiteSchema } from '../../lib/identity';
import { withBase } from '../../lib/paths';

const root = Astro.site ?? new URL('https://sangtruong.me');
const canonical = new URL(withBase('/work/internal-ai-meeting'), root).href;
const jsonLd = [
  personSchema(root),
  websiteSchema(root),
  {
    '@type': 'CreativeWork',
    '@id': `${canonical}#case-study`,
    url: canonical,
    name: 'Internal AI Meeting Tool | Sang Truong',
    description: 'An EPIC TECHNOLOGY internal meeting assistant for international product sales and technical presales, covering speech context, grounded answers, sales notes and customer follow-up.',
    author: { '@id': personId(root) },
    isPartOf: { '@id': websiteId(root) },
    inLanguage: 'en',
  },
];
const workflow = [
  ['01', 'Capture the question', 'Microphone and meeting-system audio provide live speech context. The user chooses when to request help rather than delegating a customer conversation to the model.'],
  ['02', 'Retrieve the right context', 'Selected product and project reference materials provide grounding for the current question. Source selection matters when similar products or customers are discussed.'],
  ['03', 'Suggest an answer', 'Sales, solutions and engineering roles shape the depth of the response. The tool proposes explanations while a person owns the final customer-facing answer.'],
  ['04', 'Prepare the follow-up', 'Structured notes capture discovery, objections, decisions, open questions, owners and next steps. CRM-ready text and customer email drafts support the next action.'],
];
const decisions = [
  ['A suggestion is not a commitment', 'The assistant can explain a product, but it must not quietly promise pricing, delivery dates or technical capabilities on behalf of EPIC.'],
  ['Context must belong to this conversation', 'A fluent answer grounded in the wrong project is worse than an explicit knowledge gap. Source selection and meeting-state boundaries are central to the design.'],
  ['Capture the commercial question, not just a transcript', 'A useful sales recap distinguishes pain points, buying signals, objections, decision criteria and agreed follow-ups from generic meeting minutes.'],
  ['Keep the human in control', 'Answers are user-triggered; CRM-ready means copyable structured notes, not direct CRM write-back or autonomous customer outreach.'],
];
---
<BaseLayout
  title="Internal AI Meeting Tool | Sales & Technical Presales | Sang Truong"
  description="How I built an EPIC TECHNOLOGY internal AI meeting tool for international product and technical presales: live speech, selected reference retrieval, on-demand answers and structured sales follow-ups."
  pageType="article"
  jsonLd={jsonLd}
>
  <article class="case container">
    <a class="back-link" href={withBase('/#work')}>← Selected systems</a>
    <header class="case-hero">
      <p class="eyebrow">EPIC TECHNOLOGY · Applied AI · Sales Enablement</p>
      <h1>Technical answers for the person in the customer meeting.</h1>
      <p class="case-lede">I built an Internal AI Meeting Tool at EPIC for international product sales and technical presales. It helps colleagues who do not know every engineering detail respond to customer questions using live meeting context and selected product references, then turn the conversation into actionable sales notes and follow-up drafts.</p>
      <div class="case-meta">
        <div><span>My role</span><strong>Head of AI · Hands-on Builder</strong></div>
        <div><span>Use case</span><strong>International sales and technical presales</strong></div>
        <div><span>Delivery</span><strong>EPIC internal tool</strong></div>
      </div>
    </header>

    <section class="case-section section-rule split">
      <div><p class="eyebrow">Problem</p><h2>The right answer depends on the right product context.</h2></div>
      <div class="prose">
        <p>A sales colleague may understand the customer's business but lack the implementation detail needed to explain an integration, AI capability or deployment constraint. Context is scattered across meeting audio, product materials and earlier decisions.</p>
        <p>I designed the tool around that workflow: live speech context, relevant reference retrieval, on-demand technical explanation and a structured handoff after the meeting. The goal is better-informed human responses, not autonomous selling.</p>
      </div>
    </section>

    <section class="case-section section-rule">
      <div class="section-heading compact-heading"><div><p class="eyebrow">Workflow</p><h2>From a live question to a useful next step.</h2></div><p class="section-note">A public functional view. Customer sources and internal implementation remain private.</p></div>
      <div class="architecture">
        {workflow.map(([index, name, description]) => <article><span>{index}</span><div><h3>{name}</h3><p>{description}</p></div></article>)}
      </div>
    </section>

    <section class="case-section section-rule">
      <div class="section-heading compact-heading"><div><p class="eyebrow">Engineering decisions</p><h2>Where answer quality meets business accountability.</h2></div></div>
      <div class="decision-grid">{decisions.map(([name, description]) => <article><h3>{name}</h3><p>{description}</p></article>)}</div>
    </section>

    <section class="case-section section-rule split">
      <div><p class="eyebrow">What I implemented</p><h2>Desktop, speech, retrieval and meeting state.</h2></div>
      <div class="prose">
        <p>The engineering covers a desktop interaction layer, live microphone and system-audio transcription, user-selected role and answer depth, retrieval from selected reference documents, multi-turn meeting context, and streaming answer assistance.</p>
        <p>After the conversation, the workflow produces structured discovery notes, objections, buying signals, decisions, action owners, MEDDIC-style summaries, CRM-ready text and customer follow-up drafts. I worked across the TypeScript/Electron application, AI orchestration, persistence and evaluation paths.</p>
        <p>The tool supports a human sales conversation rather than making commercial commitments. CRM-ready summaries are copyable notes, not automatic updates to a customer database; email drafts are reviewed before sending.</p>
      </div>
    </section>

    <section class="case-section section-rule case-cta">
      <p class="eyebrow">Related work</p>
      <h2>Other systems built around evidence and human decisions.</h2>
      <div class="hero-actions">
        <a class="button primary" href={withBase('/work/enterprise-agents')}>Enterprise agent orchestration</a>
        <a class="button ghost" href={withBase('/work/yhct')}>Clinical decision support</a>
        <a class="button ghost" href={withBase('/resume')}>Full résumé</a>
        <a class="button ghost" href={`mailto:${profile.email}`}>Contact</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .case { padding-top: 44px; padding-bottom: 90px; }
  .back-link { display: inline-block; margin-bottom: 50px; color: var(--muted); }
  .case-hero { max-width: 1020px; padding-bottom: 78px; }
  .case-hero h1 { max-width: 15ch; font-size: clamp(3rem, 6.5vw, 6rem); line-height: 1.05; letter-spacing: -.055em; margin: 18px 0 28px; }
  .case-lede { font-size: clamp(1.1rem, 2.1vw, 1.5rem); line-height: 1.55; max-width: 860px; }
  .case-meta { display: flex; flex-wrap: wrap; gap: 32px; margin-top: 42px; }
  .case-meta div { display: grid; gap: 8px; min-width: 180px; }
  .case-meta span { color: var(--muted); font-size: .76rem; text-transform: uppercase; letter-spacing: .1em; }
  .case-meta strong { font-size: .92rem; font-weight: 600; }
  .case-section { padding-top: 70px; padding-bottom: 74px; }
  .split { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(28px, 7vw, 90px); }
  .split h2, .section-heading h2, .case-cta h2 { max-width: 18ch; font-size: clamp(2rem, 3.8vw, 3.2rem); letter-spacing: -.04em; line-height: 1.12; }
  .prose p { color: var(--muted); font-size: 1.07rem; line-height: 1.75; margin: 0 0 1.3rem; }
  .architecture { border-top: 1px solid var(--line); }
  .architecture article { display: grid; grid-template-columns: 65px 1fr; gap: 22px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .architecture article span { color: var(--accent); font-size: .82rem; font-weight: 700; }
  .architecture h3, .decision-grid h3 { font-size: 1.14rem; margin: 0 0 8px; }
  .architecture p, .decision-grid p { color: var(--muted); line-height: 1.65; margin: 0; }
  .decision-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .decision-grid article { border: 1px solid var(--line); border-radius: 12px; padding: 25px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  @media (max-width: 760px) { .split, .decision-grid { grid-template-columns: 1fr; } .case-section { padding-top: 52px; padding-bottom: 54px; } .case-meta { gap: 22px; } }
</style>